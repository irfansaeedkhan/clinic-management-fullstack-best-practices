{
  "name": "@repo/api",
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env portless api.cms-local node --watch src/index.ts",
    "start": "pnpm with-env node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "with-env": "dotenv -e .env -e ../../.env --",
    "db:generate": "pnpm with-env drizzle-kit generate --config src/db/drizzle.config.ts",
    "db:migrate": "pnpm with-env drizzle-kit migrate --config src/db/drizzle.config.ts",
    "db:studio": "pnpm with-env drizzle-kit studio --config src/db/drizzle.config.ts",
    "db:seed": "pnpm with-env node src/scripts/seed.ts",
    "auth:generate": "pnpm with-env pnpm dlx auth@latest generate --output ./src/db/schema/auth.schema.ts --yes"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./client-types": "./src/types/api-client/index.ts",
    "./types": "./src/types/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@hono/zod-validator": "^0.8.0",
    "@repo/shared-lib": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "hono-pino": "^0.10.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "^0.31.10",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:"
  }
}
